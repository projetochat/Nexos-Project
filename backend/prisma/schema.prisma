  solvedAt                 DateTime?
  validatedAt              DateTime?
  substatus                TicketSubstatus?
  archivedAt               DateTime?
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterUser            User?               @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterContact         Contact?            @relation(fields: [requesterContactId], references: [id], onDelete: SetNull)
  customer                 Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerDepartment       CustomerDepartment? @relation(fields: [customerDepartmentId], references: [id], onDelete: SetNull)
  originBranch             CustomerBranch?     @relation(fields: [originBranchId], references: [id], onDelete: SetNull)
  conversation             Conversation?       @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  department               Department?         @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  assignedMembership       TenantMembership?   @relation("TicketAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  createdByMembership      TenantMembership?   @relation("TicketCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  closedByMembership       TenantMembership?   @relation("TicketCloser", fields: [closedByMembershipId], references: [id], onDelete: SetNull)
  comments                 TicketComment[]
  history                  TicketHistory[]
  attachments              TicketAttachment[]
  approvals                TicketApproval[]

  @@unique([tenantId, id])
  @@unique([tenantId, protocol])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, createdAt])
  @@index([tenantId, requesterContactId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerDepartmentId])
  @@index([tenantId, originBranchId])
  @@index([tenantId, conversationId])
  @@map("tickets")
}

model TicketComment {
  id                 String             @id @default(uuid())
  tenantId           String
  ticketId           String
  authorMembershipId String?
  authorNameSnapshot String?
  bodyText           String
  bodyHtmlSanitized  String?
  internal           Boolean            @default(true)
  dialogType         TicketDialogType   @default(RESPONSE)
  editedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  archivedAt         DateTime?
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket             Ticket             @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  authorMembership   TenantMembership?  @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)
  attachments        TicketAttachment[]
  requestedApprovals TicketApproval[]   @relation("TicketApprovalRequestComment")
  decidedApprovals   TicketApproval[]   @relation("TicketApprovalDecisionComment")

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@index([authorMembershipId])
  @@map("ticket_comments")
}

model TicketApproval {
  id                      String               @id @default(uuid())
  tenantId                String
  ticketId                String
  kind                    TicketApprovalKind
  status                  TicketApprovalStatus @default(PENDING)
  requestedByMembershipId String?
  requestedByNameSnapshot String?
  approverMembershipId    String?
  approverContactId       String?
  requestCommentId        String?
  decisionCommentId       String?
  requestedAt             DateTime             @default(now())
  decidedAt               DateTime?
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket                  Ticket               @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  requestedByMembership   TenantMembership?    @relation("TicketApprovalRequester", fields: [requestedByMembershipId], references: [id], onDelete: SetNull)
  approverMembership      TenantMembership?    @relation("TicketApprovalAssignee", fields: [approverMembershipId], references: [id], onDelete: SetNull)
  decidedByMembership     TenantMembership?    @relation("TicketApprovalDecider", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)
  approverContact         Contact?             @relation(fields: [approverContactId], references: [id], onDelete: SetNull)
  requestComment          TicketComment?       @relation("TicketApprovalRequestComment", fields: [requestCommentId], references: [id], onDelete: SetNull)
  decisionComment         TicketComment?       @relation("TicketApprovalDecisionComment", fields: [decisionCommentId], references: [id], onDelete: SetNull)
  decidedByMembershipId   String?

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, requestedAt])
  @@index([tenantId, approverMembershipId, status])
  @@index([tenantId, approverContactId, status])
  @@map("ticket_approvals")
}

model TicketHistory {
  id                String            @id @default(uuid())
  tenantId          String
  ticketId          String
  actorMembershipId String?
  event             String
  fromValue         String?
  toValue           String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket            Ticket            @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, event])
  @@map("ticket_history")
}

model TicketAttachment {
  id                     String                 @id @default(uuid())
  tenantId               String
  ticketId               String
  commentId              String?
  uploadedByMembershipId String?
  uploadedByNameSnapshot String?
  storageProvider        String
  objectKey              String
  originalNameSanitized  String
  mimeType               String
  sizeBytes              Int
  checksum               String?
  status                 TicketAttachmentStatus @default(PENDING)
  scanStatus             AttachmentScanStatus   @default(NOT_SCANNED)
  createdAt              DateTime               @default(now())
  deletedAt              DateTime?
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket                 Ticket                 @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  comment                TicketComment?         @relation(fields: [tenantId, commentId], references: [tenantId, id], onDelete: Restrict)
  uploadedByMembership   TenantMembership?      @relation(fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, status])
  @@map("ticket_attachments")
}

model ContactMessagingPreference {
  id               String                     @id @default(uuid())
  tenantId         String
  contactId        String
  channel          MessagingPreferenceChannel @default(WHATSAPP)
  marketingAllowed Boolean                    @default(true)
  optedOutAt       DateTime?
  source           String                     @default("manual")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact                    @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, contactId, channel])
  @@index([tenantId, marketingAllowed])
  @@map("contact_messaging_preferences")
}

model UserInvitation {
  id                    String               @id @default(uuid())
  tenantId              String
  email                 String
  roleId                String
  departmentIds         String[]             @default([])
  tokenHash             String
  status                UserInvitationStatus @default(PENDING)
  expiresAt             DateTime
  invitedByMembershipId String?
  contactId             String?
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                  Role                 @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  invitedByMembership   TenantMembership?    @relation("InvitationSender", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)
  contact               Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([tokenHash])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@index([tenantId, contactId, status])
  @@map("user_invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Lead {
  id                   String            @id @default(uuid())
  tenantId             String
  contactId            String
  conversationId       String
  departmentId         String?
  assignedMembershipId String?
  source               LeadSource        @default(WHATSAPP)
  status               LeadStatus        @default(NEW)
  firstMessagePreview  String?
  convertedAt          DateTime?
  discardedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact              Contact           @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  conversation         Conversation      @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  department           Department?       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  assignedMembership   TenantMembership? @relation("LeadAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, assignedMembershipId])
  @@map("leads")
}

model Notification {
  id           String             @id @default(uuid())
  tenantId     String
  membershipId String?
  departmentId String?
  connectionId String?
  kind         NotificationKind
  status       NotificationStatus @default(UNREAD)
  title        String
  body         String?
  entityType   String?
  entityId     String?
  createdAt    DateTime           @default(now())
  readAt       DateTime?
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   TenantMembership?  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department   Department?        @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, status, createdAt])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, connectionId, status])
  @@index([tenantId, kind, createdAt])
  @@map("notifications")
}

model AutomationRule {
  id                    String               @id @default(uuid())
  tenantId              String
  name                  String
  status                AutomationRuleStatus @default(ACTIVE)
  actionType            AutomationActionType @default(BOT_REPLY)
  matchText             String
  responseText          String?
  departmentId          String?
  createdByMembershipId String?
  archivedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department            Department?          @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  createdByMembership   TenantMembership?    @relation("AutomationCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, status, archivedAt])
  @@index([tenantId, departmentId])
  @@map("automation_rules")
}

model Campaign {
  id                      String                @id @default(uuid())
  tenantId                String
  name                    String
  description             String?
  status                  CampaignStatus        @default(DRAFT)
  messageType             CampaignMessageType   @default(TEXT)
  messageText             String
  connectionId            String
  audienceType            CampaignAudienceType
  audienceTagMatchMode    CampaignTagMatchMode?
  audienceTagIds          String[]              @default([])
  audienceCustomerIds     String[]              @default([])
  audienceContactIds      String[]              @default([])
  timezone                String                @default("America/Sao_Paulo")
  scheduledAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancelledByMembershipId String?
  createdByMembershipId   String?
  createdByNameSnapshot   String?
  archivedAt              DateTime?
  version                 Int                   @default(1)
  totalCount              Int                   @default(0)
  eligibleCount           Int                   @default(0)
  invalidPhoneCount       Int                   @default(0)
  optedOutCount           Int                   @default(0)
  duplicateCount          Int                   @default(0)
  blockedCount            Int                   @default(0)
  sentCount               Int                   @default(0)
  deliveredCount          Int                   @default(0)
  readCount               Int                   @default(0)
  failedCount             Int                   @default(0)
  skippedCount            Int                   @default(0)
  cancelledCount          Int                   @default(0)
  lastErrorCode           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection              MessagingConnection   @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  createdByMembership     TenantMembership?     @relation("CampaignCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  cancelledByMembership   TenantMembership?     @relation("CampaignCanceller", fields: [cancelledByMembershipId], references: [id], onDelete: SetNull)
  recipients              CampaignRecipient[]
  messages                Message[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, connectionId])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String                       @id @default(uuid())
  tenantId          String
  campaignId        String
  contactId         String
  customerId        String?
  normalizedPhone   String
  displayName       String?
  renderedMessage   String?
  status            CampaignRecipientStatus      @default(PENDING)
  skipReason        CampaignRecipientSkipReason?
  messageId         String?
  externalMessageId String?
  queuedAt          DateTime?
  processingAt      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  attempts          Int                          @default(0)
  lastErrorCode     String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign          Campaign                     @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  contact           Contact                      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  customer          Customer?                    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  messages          Message[]

  @@unique([campaignId, contactId])
  @@unique([tenantId, id])
  @@index([campaignId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, messageId])
  @@index([tenantId, externalMessageId])
  @@map("campaign_recipients")
}

model Schedule {
  id                    String                   @default(uuid())
  tenantId              String
  connectionId          String?
  payload               Json
  dueAt                 DateTime?
  executionStatus       ScheduleExecutionStatus?
  claimedAt             DateTime?
  messageId             String?
  attempts              Int                      @default(0)
  lastError             String?
  completedAt           DateTime?
  createdByMembershipId String?
  nextAttemptAt         DateTime?
  version               Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([executionStatus, dueAt])
  @@index([executionStatus, nextAttemptAt])
  @@index([tenantId, messageId])
  @@map("schedules")
}
