generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum PlatformRole {
  USER
  ADMIN
}

enum ContactCompanyRole {
  COLABORADOR
  SUPERVISOR
  GERENTE
  DIRETORIA
}

enum ConversationStatus {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  FECHADA
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

enum MessageStatus {
  CREATED
  SENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum MessagingProviderType {
  DEVELOPMENT
  EVOLUTION
  META_CLOUD
}

enum MessagingConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

model Tenant {
  id                          String                       @id @default(uuid())
  name                        String
  slug                        String                       @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  users                       TenantMembership[]
  departments                 Department[]
  roles                       Role[]
  customers                   Customer[]
  contacts                    Contact[]
  tags                        Tag[]
  conversations               Conversation[]
  messages                    Message[]
  messagingConnections        MessagingConnection[]
  conversationProtocolCounter ConversationProtocolCounter?

  @@map("tenants")
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String
  passwordHash String
  status       UserStatus         @default(ACTIVE)
  platformRole PlatformRole       @default(USER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  TenantMembership[]

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model TenantMembership {
  id            String                 @id @default(uuid())
  tenantId      String
  userId        String
  roleId        String
  status        MembershipStatus       @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role                   @relation(fields: [tenantId, roleId], references: [tenantId, id])
  departments   DepartmentMembership[]
  conversations Conversation[]
  messages      Message[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@index([roleId])
  @@index([status])
  @@map("tenant_memberships")
}

model Department {
  id            String                 @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  color         String                 @default("#6366f1")
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       DepartmentMembership[]
  contacts      Contact[]
  conversations Conversation[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([active])
  @@map("departments")
}

model DepartmentMembership {
  id           String           @id @default(uuid())
  tenantId     String
  departmentId String
  membershipId String
  createdAt    DateTime         @default(now())
  department   Department       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@unique([departmentId, membershipId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([membershipId])
  @@map("department_memberships")
}

model Role {
  id          String             @id @default(uuid())
  tenantId    String
  key         String
  name        String
  description String?
  metadata    Json?
  system      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Customer {
  id                     String    @id @default(uuid())
  tenantId               String
  name                   String
  email                  String?
  phone                  String?
  notes                  String?
  responsibleContactName String?
  color                  String    @default("#6366f1")
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts               Contact[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, archivedAt])
  @@map("customers")
}

model Contact {
  id              String              @id @default(uuid())
  tenantId        String
  customerId      String?
  departmentId    String?
  name            String
  phone           String
  normalizedPhone String
  email           String?
  avatarUrl       String?
  departmentName  String?
  companyRole     ContactCompanyRole?
  instance        String?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  department      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tags            ContactTag[]
  conversations   Conversation[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedPhone])
  @@index([tenantId, name])
  @@index([tenantId, customerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, departmentName])
  @@index([tenantId, instance])
  @@index([tenantId, archivedAt])
  @@map("contacts")
}

model Tag {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model ContactTag {
  tenantId  String
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tenantId])
  @@index([tagId])
  @@map("contact_tags")
}

model ConversationProtocolCounter {
  tenantId   String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("conversation_protocol_counters")
}

model Conversation {
  id                   String             @id @default(uuid())
  tenantId             String
  contactId            String
  departmentId         String?
  assignedMembershipId String?
  connectionId          String?
  status               ConversationStatus @default(ABERTA)
  protocol             String?
  isGroup              Boolean            @default(false)
  unreadCount          Int                @default(0)
  lastMessagePreview   String?
  lastMessageAt        DateTime?
  archivedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact              Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  department           Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedMembership   TenantMembership?  @relation(fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  connection           MessagingConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  messages             Message[]

  @@unique([tenantId, id])
  @@unique([tenantId, protocol])
  @@index([tenantId, status, archivedAt])
  @@index([tenantId, departmentId])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, connectionId])
  @@index([tenantId, contactId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                 String            @id @default(uuid())
  tenantId           String
  conversationId     String
  connectionId       String?
  direction          MessageDirection
  type               MessageType       @default(TEXT)
  status             MessageStatus     @default(CREATED)
  authorMembershipId String?
  content            String?
  clientMessageId    String?
  providerMessageId  String?
  providerStatus     String?
  providerErrorCode  String?
  providerErrorMessage String?
  providerAcceptedAt DateTime?
  externalMessageId  String?
  readAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation       Conversation      @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  connection         MessagingConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  authorMembership   TenantMembership? @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, conversationId, clientMessageId])
  @@unique([tenantId, connectionId, externalMessageId])
  @@index([tenantId])
  @@index([tenantId, connectionId])
  @@index([tenantId, providerMessageId])
  @@index([tenantId, conversationId, createdAt, id])
  @@index([conversationId])
  @@map("messages")
}

model MessagingConnection {
  id                String                    @id @default(uuid())
  tenantId          String
  name              String
  providerType      MessagingProviderType
  status            MessagingConnectionStatus @default(DISCONNECTED)
  externalReference String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  messages          Message[]

  @@unique([tenantId, id])
  @@unique([tenantId, providerType, externalReference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("messaging_connections")
}
