generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum PlatformRole {
  USER
  ADMIN
}

enum ContactCompanyRole {
  COLABORADOR
  SUPERVISOR
  GERENTE
  DIRETORIA
}

enum ConversationStatus {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  FECHADA
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

enum MessageStatus {
  CREATED
  QUEUED
  SENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MessagingProviderType {
  DEVELOPMENT
  EVOLUTION
  META_CLOUD
}

enum MessagingConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO
  RESOLVIDO
  FECHADO
  CANCELADO
}

enum TicketPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum TicketCategory {
  SUPORTE
  DEV
  FINANCEIRO
  OPERACIONAL
}

enum TicketAttachmentStatus {
  PENDING
  READY
  DELETED
  REJECTED
}

enum AttachmentScanStatus {
  NOT_SCANNED
  CLEAN
  BLOCKED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
}

enum CampaignMessageType {
  TEXT
}

enum CampaignAudienceType {
  ALL
  TAGS
  CUSTOMERS
  CONTACTS
}

enum CampaignTagMatchMode {
  ANY
  ALL
}

enum CampaignRecipientStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  CANCELLED
}

enum CampaignRecipientSkipReason {
  INVALID_PHONE
  OPT_OUT
  BLOCKED
  DUPLICATE
  ARCHIVED_CONTACT
  TEMPLATE_RENDER_FAILED
  CAMPAIGN_CANCELLED
}

enum MessagingPreferenceChannel {
  WHATSAPP
}

model Tenant {
  id                          String                       @id @default(uuid())
  name                        String
  slug                        String                       @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  users                       TenantMembership[]
  departments                 Department[]
  roles                       Role[]
  customers                   Customer[]
  contacts                    Contact[]
  tags                        Tag[]
  quickReplies                QuickReply[]
  conversations               Conversation[]
  messages                    Message[]
  messagingConnections        MessagingConnection[]
  outboxEvents                OutboxEvent[]
  conversationProtocolCounter ConversationProtocolCounter?
  ticketProtocolCounter       TicketProtocolCounter?
  tickets                     Ticket[]
  ticketComments              TicketComment[]
  ticketHistory               TicketHistory[]
  ticketAttachments           TicketAttachment[]
  campaigns                   Campaign[]
  campaignRecipients          CampaignRecipient[]
  contactMessagingPreferences ContactMessagingPreference[]

  @@map("tenants")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  name             String
  passwordHash     String
  status           UserStatus         @default(ACTIVE)
  platformRole     PlatformRole       @default(USER)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  memberships      TenantMembership[]
  requestedTickets Ticket[]

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model TenantMembership {
  id                 String                 @id @default(uuid())
  tenantId           String
  userId             String
  roleId             String
  status             MembershipStatus       @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               Role                   @relation(fields: [tenantId, roleId], references: [tenantId, id])
  departments        DepartmentMembership[]
  conversations      Conversation[]
  messages           Message[]
  quickReplies       QuickReply[]
  assignedTickets    Ticket[]               @relation("TicketAssignee")
  createdTickets     Ticket[]               @relation("TicketCreator")
  closedTickets      Ticket[]               @relation("TicketCloser")
  ticketComments     TicketComment[]
  ticketHistory      TicketHistory[]
  ticketAttachments  TicketAttachment[]
  createdCampaigns   Campaign[]             @relation("CampaignCreator")
  cancelledCampaigns Campaign[]             @relation("CampaignCanceller")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@index([roleId])
  @@index([status])
  @@map("tenant_memberships")
}

model Department {
  id            String                 @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  color         String                 @default("#6366f1")
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       DepartmentMembership[]
  contacts      Contact[]
  conversations Conversation[]
  quickReplies  QuickReply[]
  tickets       Ticket[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([active])
  @@map("departments")
}

model DepartmentMembership {
  id           String           @id @default(uuid())
  tenantId     String
  departmentId String
  membershipId String
  createdAt    DateTime         @default(now())
  department   Department       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@unique([departmentId, membershipId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([membershipId])
  @@map("department_memberships")
}

model Role {
  id          String             @id @default(uuid())
  tenantId    String
  key         String
  name        String
  description String?
  metadata    Json?
  system      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Customer {
  id                     String              @id @default(uuid())
  tenantId               String
  name                   String
  email                  String?
  phone                  String?
  notes                  String?
  responsibleContactName String?
  color                  String              @default("#6366f1")
  archivedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts               Contact[]
  campaignRecipients     CampaignRecipient[]
  tickets                Ticket[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, archivedAt])
  @@map("customers")
}

model Contact {
  id                   String                       @id @default(uuid())
  tenantId             String
  customerId           String?
  departmentId         String?
  name                 String
  phone                String
  normalizedPhone      String
  email                String?
  avatarUrl            String?
  departmentName       String?
  companyRole          ContactCompanyRole?
  instance             String?
  archivedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  department           Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tags                 ContactTag[]
  conversations        Conversation[]
  tickets              Ticket[]
  campaignRecipients   CampaignRecipient[]
  messagingPreferences ContactMessagingPreference[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedPhone])
  @@index([tenantId, name])
  @@index([tenantId, customerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, departmentName])
  @@index([tenantId, instance])
  @@index([tenantId, archivedAt])
  @@map("contacts")
}

model Tag {
  id             String       @id @default(uuid())
  tenantId       String
  name           String
  normalizedName String
  color          String       @default("#6366f1")
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts       ContactTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, archivedAt])
  @@map("tags")
}

model ContactTag {
  tenantId  String
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tenantId])
  @@index([tagId])
  @@map("contact_tags")
}

model ConversationProtocolCounter {
  tenantId   String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("conversation_protocol_counters")
}

model Conversation {
  id                   String               @id @default(uuid())
  tenantId             String
  contactId            String
  departmentId         String?
  assignedMembershipId String?
  connectionId         String?
  status               ConversationStatus   @default(ABERTA)
  protocol             String?
  isGroup              Boolean              @default(false)
  unreadCount          Int                  @default(0)
  lastMessagePreview   String?
  lastMessageAt        DateTime?
  archivedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact              Contact              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedMembership   TenantMembership?    @relation(fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  connection           MessagingConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  messages             Message[]
  tickets              Ticket[]

  @@unique([tenantId, id])
  @@unique([tenantId, protocol])
  @@index([tenantId, status, archivedAt])
  @@index([tenantId, departmentId])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, connectionId])
  @@index([tenantId, contactId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                   String               @id @default(uuid())
  tenantId             String
  conversationId       String
  connectionId         String?
  direction            MessageDirection
  type                 MessageType          @default(TEXT)
  status               MessageStatus        @default(CREATED)
  authorMembershipId   String?
  content              String?
  clientMessageId      String?
  providerMessageId    String?
  providerStatus       String?
  providerErrorCode    String?
  providerErrorMessage String?
  providerAcceptedAt   DateTime?
  campaignId           String?
  campaignRecipientId  String?
  sendAttempts         Int                  @default(0)
  lastAttemptAt        DateTime?
  externalMessageId    String?
  readAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation         Conversation         @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  connection           MessagingConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  authorMembership     TenantMembership?    @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)
  campaign             Campaign?            @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: NoAction)
  campaignRecipient    CampaignRecipient?   @relation(fields: [tenantId, campaignRecipientId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, conversationId, clientMessageId])
  @@unique([tenantId, connectionId, externalMessageId])
  @@index([tenantId])
  @@index([tenantId, connectionId])
  @@index([tenantId, providerMessageId])
  @@index([tenantId, campaignId])
  @@index([tenantId, campaignRecipientId])
  @@index([tenantId, conversationId, createdAt, id])
  @@index([conversationId])
  @@map("messages")
}

model OutboxEvent {
  id           String            @id @default(uuid())
  tenantId     String
  type         String
  aggregateId  String
  payload      Json
  status       OutboxEventStatus @default(PENDING)
  attempts     Int               @default(0)
  processingAt DateTime?
  processedAt  DateTime?
  lastError    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, aggregateId])
  @@index([status, createdAt])
  @@index([tenantId, status])
  @@map("outbox_events")
}

model MessagingConnection {
  id                   String                    @id @default(uuid())
  tenantId             String
  name                 String
  providerType         MessagingProviderType
  status               MessagingConnectionStatus @default(DISCONNECTED)
  externalReference    String?
  ownerExternalId      String?
  ownerPhoneNormalized String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations        Conversation[]
  messages             Message[]
  campaigns            Campaign[]

  @@unique([tenantId, id])
  @@unique([tenantId, providerType, externalReference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerPhoneNormalized])
  @@map("messaging_connections")
}

model QuickReply {
  id                    String            @id @default(uuid())
  tenantId              String
  title                 String
  shortcut              String
  normalizedShortcut    String
  content               String
  departmentId          String?
  createdByMembershipId String?
  archivedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department            Department?       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  createdByMembership   TenantMembership? @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, departmentId, normalizedShortcut])
  @@unique([tenantId, id])
  @@index([tenantId, archivedAt])
  @@index([tenantId, departmentId])
  @@map("quick_replies")
}

model TicketProtocolCounter {
  tenantId   String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ticket_protocol_counters")
}

model Ticket {
  id                       String             @id @default(uuid())
  tenantId                 String
  number                   Int
  protocol                 String
  title                    String
  descriptionText          String
  descriptionHtmlSanitized String
  status                   TicketStatus       @default(ABERTO)
  priority                 TicketPriority     @default(NORMAL)
  category                 TicketCategory     @default(SUPORTE)
  requesterUserId          String?
  requesterContactId       String?
  customerId               String?
  conversationId           String?
  departmentId             String
  assignedMembershipId     String?
  createdByMembershipId    String
  closedByMembershipId     String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  closedAt                 DateTime?
  archivedAt               DateTime?
  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterUser            User?              @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterContact         Contact?           @relation(fields: [requesterContactId], references: [id], onDelete: SetNull)
  customer                 Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation             Conversation?      @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  department               Department         @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  assignedMembership       TenantMembership?  @relation("TicketAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  createdByMembership      TenantMembership   @relation("TicketCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  closedByMembership       TenantMembership?  @relation("TicketCloser", fields: [closedByMembershipId], references: [id], onDelete: SetNull)
  comments                 TicketComment[]
  history                  TicketHistory[]
  attachments              TicketAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, protocol])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, createdAt])
  @@index([tenantId, requesterContactId])
  @@index([tenantId, customerId])
  @@index([tenantId, conversationId])
  @@map("tickets")
}

model TicketComment {
  id                 String             @id @default(uuid())
  tenantId           String
  ticketId           String
  authorMembershipId String
  bodyText           String
  bodyHtmlSanitized  String?
  internal           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  archivedAt         DateTime?
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket             Ticket             @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  authorMembership   TenantMembership   @relation(fields: [authorMembershipId], references: [id], onDelete: Restrict)
  attachments        TicketAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@index([authorMembershipId])
  @@map("ticket_comments")
}

model TicketHistory {
  id                String            @id @default(uuid())
  tenantId          String
  ticketId          String
  actorMembershipId String?
  event             String
  fromValue         String?
  toValue           String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket            Ticket            @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, event])
  @@map("ticket_history")
}

model TicketAttachment {
  id                     String                 @id @default(uuid())
  tenantId               String
  ticketId               String
  commentId              String?
  uploadedByMembershipId String
  storageProvider        String
  objectKey              String
  originalNameSanitized  String
  mimeType               String
  sizeBytes              Int
  checksum               String?
  status                 TicketAttachmentStatus @default(PENDING)
  scanStatus             AttachmentScanStatus   @default(NOT_SCANNED)
  createdAt              DateTime               @default(now())
  deletedAt              DateTime?
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket                 Ticket                 @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  comment                TicketComment?         @relation(fields: [tenantId, commentId], references: [tenantId, id], onDelete: Restrict)
  uploadedByMembership   TenantMembership       @relation(fields: [uploadedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, status])
  @@map("ticket_attachments")
}

model ContactMessagingPreference {
  id               String                     @id @default(uuid())
  tenantId         String
  contactId        String
  channel          MessagingPreferenceChannel @default(WHATSAPP)
  marketingAllowed Boolean                    @default(true)
  optedOutAt       DateTime?
  source           String                     @default("manual")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact                    @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, contactId, channel])
  @@index([tenantId, marketingAllowed])
  @@map("contact_messaging_preferences")
}

model Campaign {
  id                      String                @id @default(uuid())
  tenantId                String
  name                    String
  description             String?
  status                  CampaignStatus        @default(DRAFT)
  messageType             CampaignMessageType   @default(TEXT)
  messageText             String
  connectionId            String
  audienceType            CampaignAudienceType
  audienceTagMatchMode    CampaignTagMatchMode?
  audienceTagIds          String[]              @default([])
  audienceCustomerIds     String[]              @default([])
  audienceContactIds      String[]              @default([])
  timezone                String                @default("America/Sao_Paulo")
  scheduledAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancelledByMembershipId String?
  createdByMembershipId   String
  archivedAt              DateTime?
  version                 Int                   @default(1)
  totalCount              Int                   @default(0)
  eligibleCount           Int                   @default(0)
  invalidPhoneCount       Int                   @default(0)
  optedOutCount           Int                   @default(0)
  duplicateCount          Int                   @default(0)
  blockedCount            Int                   @default(0)
  sentCount               Int                   @default(0)
  deliveredCount          Int                   @default(0)
  readCount               Int                   @default(0)
  failedCount             Int                   @default(0)
  skippedCount            Int                   @default(0)
  cancelledCount          Int                   @default(0)
  lastErrorCode           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection              MessagingConnection   @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  createdByMembership     TenantMembership      @relation("CampaignCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  cancelledByMembership   TenantMembership?     @relation("CampaignCanceller", fields: [cancelledByMembershipId], references: [id], onDelete: SetNull)
  recipients              CampaignRecipient[]
  messages                Message[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, connectionId])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String                       @id @default(uuid())
  tenantId          String
  campaignId        String
  contactId         String
  customerId        String?
  normalizedPhone   String
  displayName       String?
  renderedMessage   String?
  status            CampaignRecipientStatus      @default(PENDING)
  skipReason        CampaignRecipientSkipReason?
  messageId         String?
  externalMessageId String?
  queuedAt          DateTime?
  processingAt      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  attempts          Int                          @default(0)
  lastErrorCode     String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign          Campaign                     @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  contact           Contact                      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  customer          Customer?                    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  messages          Message[]

  @@unique([campaignId, contactId])
  @@unique([tenantId, id])
  @@index([campaignId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, messageId])
  @@index([tenantId, externalMessageId])
  @@map("campaign_recipients")
}
