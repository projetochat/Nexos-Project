generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum PlatformRole {
  USER
  ADMIN
  SUPPORT
  READONLY
}

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  TERMINATED
}

enum TenantOnboardingStatus {
  PENDING
  COMPLETED
}

enum PlatformClientStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  PROSPECTING
}

enum PlanStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

enum PlanBillingPeriod {
  MONTHLY
  YEARLY
  MANUAL
}

enum SubscriptionStatus {
  REGISTERING
  AWAITING_FINANCE
  FINANCE_RELEASED
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  OVERDUE
  RELEASED
}

enum ImpersonationStatus {
  ACTIVE
  STOPPED
  EXPIRED
}

enum ContactCompanyRole {
  COLABORADOR
  SUPERVISOR
  GERENTE
  DIRETORIA
}

enum ContactCustomFieldType {
  TEXT
  NUMBER
  CHECKBOX
  LIST
  DATE
}

enum ProtocolModule {
  CHAT
  TICKET
}

enum ProtocolFormat {
  YEAR_SEQUENCE
  YEAR_MONTH_SEQUENCE
  SEQUENCE
  DATE_SEQUENCE
  CUSTOM
}

enum ProtocolReset {
  YEARLY
  MONTHLY
  NEVER
}

enum ConversationStatus {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  FECHADA
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessagingHistoryImportKind {
  DIRECT
  GROUP
}

enum MessagingHistoryImportStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VOICE
  VIDEO
  DOCUMENT
  SYSTEM
}

enum MessageStatus {
  PENDING
  CREATED
  QUEUED
  SENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum MessageReactionActorType {
  TRIXUS_USER
  EXTERNAL_PARTICIPANT
  CONTACT
  SYSTEM
}

enum MessageMediaState {
  PENDING
  DOWNLOADING
  READY
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ScheduleExecutionStatus {
  PENDING
  CLAIMED
  QUEUED
  SENT
  FAILED
}

enum MessagingProviderType {
  DEVELOPMENT
  EVOLUTION
  META_CLOUD
}

enum MessagingConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
  REMOVED
}

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO
  RESOLVIDO
  FECHADO
  CANCELADO
  NOVO
  AGUARDANDO_APROVACAO
  NA_FILA
  EM_EXECUCAO
  CONCLUIDA
  VALIDADO
  REPROVADO
}

enum TicketPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
  ALTISSIMA
}

enum TicketCategory {
  SUPORTE
  DEV
  FINANCEIRO
  OPERACIONAL
}

enum TicketAttachmentStatus {
  PENDING
  READY
  DELETED
  REJECTED
}

enum TicketDialogType {
  RESPONSE
  TRANSFER
  APPROVAL_REQUEST
  SOLUTION
  CANCELLATION
  APPROVAL_DECISION
  SOLUTION_VALIDATION
}

enum TicketApprovalKind {
  SUPPORT
  DEVELOPMENT
  SOLUTION_VALIDATION
}

enum TicketApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketSubstatus {
  OPENED_IN_SANKHYA
  FORWARDED_TO_THIRD_PARTY
  WAITING
  WAITING_INFRASTRUCTURE
}

enum AttachmentScanStatus {
  NOT_SCANNED
  CLEAN
  BLOCKED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
}

enum CampaignMessageType {
  TEXT
}

enum CampaignAudienceType {
  ALL
  TAGS
  CUSTOMERS
  CONTACTS
}

enum CampaignTagMatchMode {
  ANY
  ALL
}

enum CampaignRecipientStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  CANCELLED
}

enum CampaignRecipientSkipReason {
  INVALID_PHONE
  OPT_OUT
  BLOCKED
  DUPLICATE
  ARCHIVED_CONTACT
  TEMPLATE_RENDER_FAILED
  CAMPAIGN_CANCELLED
}

enum MessagingPreferenceChannel {
  WHATSAPP
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CustomerPersonType {
  PHYSICAL
  LEGAL
}

enum CustomerStatus {
  ACTIVE
  PROSPECT
  SUSPENDED
  CANCELLED
}

enum CustomerAccessProfile {
  COLLABORATOR
  MANAGER
  FULL_ACCESS
}

enum CustomerBranchStatus {
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  QUEUED
  ASSIGNED
  CONVERTED
  DISCARDED
}

enum LeadSource {
  WHATSAPP
  MANUAL
  CAMPAIGN
  BOT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationKind {
  LEAD_CREATED
  CONVERSATION_ASSIGNED
  TICKET_UPDATED
  CAMPAIGN_COMPLETED
  SYSTEM
}

enum AutomationRuleStatus {
  ACTIVE
  DISABLED
}

enum AutomationActionType {
  BOT_REPLY
  ASSIGN_DEPARTMENT
  NOTIFY_TEAM
}

model Tenant {
  schedules                   Schedule[]
  id                          String                          @id @default(uuid())
  name                        String
  slug                        String                          @unique
  legalName                   String?
  displayName                 String?
  status                      TenantStatus                    @default(ACTIVE)
  timezone                    String                          @default("America/Sao_Paulo")
  locale                      String                          @default("pt-BR")
  document                    String?
  billingEmail                String?
  technicalEmail              String?
  responsibleName             String?
  responsibleEmail            String?
  responsiblePhone            String?
  responsibleTitle            String?
  notes                       String?
  maxUsers                    Int?
  maxConnections              Int?
  featureOverrides            Json?
  limitOverrides              Json?
  authRevokedAt               DateTime?
  activatedAt                 DateTime?
  suspendedAt                 DateTime?
  terminatedAt                DateTime?
  suspensionReason            String?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  users                       TenantMembership[]
  departments                 Department[]
  roles                       Role[]
  customers                   Customer[]
  customerBranches            CustomerBranch[]
  customerDepartments         CustomerDepartment[]
  contacts                    Contact[]
  contactDepartments          ContactDepartment[]
  contactProfiles             ContactProfile[]
  contactCustomFields         ContactCustomField[]
  tags                        Tag[]
  quickReplies                QuickReply[]
  conversations               Conversation[]
  conversationParticipants    ConversationParticipant[]
  messages                    Message[]
  messageReactions            MessageReaction[]
  messagingConnections        MessagingConnection[]
  historyImports              MessagingHistoryImport[]
  outboxEvents                OutboxEvent[]
  conversationProtocolCounter ConversationProtocolCounter?
  ticketProtocolCounter       TicketProtocolCounter?
  tickets                     Ticket[]
  ticketComments              TicketComment[]
  ticketHistory               TicketHistory[]
  ticketAttachments           TicketAttachment[]
  ticketApprovals             TicketApproval[]
  campaigns                   Campaign[]
  campaignRecipients          CampaignRecipient[]
  contactMessagingPreferences ContactMessagingPreference[]
  subscriptions               TenantSubscription[]
  invoices                    Invoice[]
  usageSnapshots              TenantUsageSnapshot[]
  auditLogs                   PlatformAuditLog[]
  impersonationSessions       ImpersonationSession[]
  authSessions                AuthSession[]
  invitations                 UserInvitation[]
  leads                       Lead[]
  notifications               Notification[]
  automationRules             AutomationRule[]
  platformClient              PlatformClient?
  onboarding                  TenantOnboarding?
  dashboardConfiguration      TenantDashboardConfiguration?
  protocolConfigurations      TenantProtocolConfiguration[]
  protocolSequenceCounters    ProtocolSequenceCounter[]
  registrationCaseSettings    TenantRegistrationCaseSettings?

  @@index([status])
  @@map("tenants")
}

model TenantRegistrationCaseSettings {
  tenantId           String   @id
  contacts           Boolean  @default(false)
  contactCompanies   Boolean  @default(false) @map("contact_companies")
  contactDepartments Boolean  @default(false) @map("contact_departments")
  contactProfiles    Boolean  @default(false) @map("contact_profiles")
  attendants         Boolean  @default(false)
  accessProfiles     Boolean  @default(false) @map("access_profiles")
  departments        Boolean  @default(false)
  tags               Boolean  @default(false)
  botFlows           Boolean  @default(false) @map("bot_flows")
  automations        Boolean  @default(false)
  aiAgents           Boolean  @default(false) @map("ai_agents")
  ticketTitles       Boolean  @default(false) @map("ticket_titles")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_registration_case_settings")
}

model TenantProtocolConfiguration {
  tenantId      String
  module        ProtocolModule
  format        ProtocolFormat
  digits        Int            @default(6)
  reset         ProtocolReset  @default(NEVER)
  customPattern String?
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, module])
  @@map("tenant_protocol_configurations")
}

model ProtocolSequenceCounter {
  tenantId   String
  module     ProtocolModule
  periodKey  String
  lastNumber Int            @default(0)
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, module, periodKey])
  @@map("protocol_sequence_counters")
}

model TenantDashboardConfiguration {
  tenantId      String   @id
  configuration Json
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_dashboard_configurations")
}

model TenantOnboarding {
  tenantId         String                 @id
  status           TenantOnboardingStatus @default(PENDING)
  currentStep      Int                    @default(1)
  maxCompletedStep Int                    @default(0)
  version          Int                    @default(1)
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("tenant_onboarding_states")
}

model PlatformClient {
  id               String               @id @default(uuid())
  name             String
  document         String?              @unique
  responsibleName  String
  responsibleEmail String
  city             String
  state            String
  country          String               @default("Brasil")
  cityId           String?              @map("city_id")
  registeredAt     DateTime             @default(now())
  status           PlatformClientStatus @default(ACTIVE)
  notes            String?
  tenantId         String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  cityReference    City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  subscriptions    TenantSubscription[]

  @@index([name])
  @@index([city, state])
  @@index([cityId])
  @@index([status])
  @@map("platform_clients")
}

model Country {
  id         String                   @id @default(uuid())
  code       String                   @unique @db.VarChar(2)
  name       String
  geonamesId String?                  @unique @map("geonames_id")
  active     Boolean                  @default(true)
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")
  divisions  AdministrativeDivision[]
  cities     City[]

  @@index([active, name])
  @@map("countries")
}

model AdministrativeDivision {
  id         String   @id @default(uuid())
  countryId  String   @map("country_id")
  code       String
  name       String
  geonamesId String?  @unique @map("geonames_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities     City[]

  @@unique([countryId, code])
  @@index([countryId, active, name])
  @@map("administrative_divisions")
}

model City {
  id              String                  @id @default(uuid())
  name            String
  normalizedName  String                  @map("normalized_name")
  dedupeKey       String                  @unique @map("dedupe_key")
  countryId       String                  @map("country_id")
  divisionId      String?                 @map("division_id")
  ibgeCode        String?                 @unique @map("ibge_code")
  geonamesId      String?                 @unique @map("geonames_id")
  latitude        Float?
  longitude       Float?
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  country         Country                 @relation(fields: [countryId], references: [id], onDelete: Restrict)
  division        AdministrativeDivision? @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  customers       Customer[]
  platformClients PlatformClient[]

  @@index([countryId, divisionId, active, normalizedName])
  @@index([normalizedName])
  @@index([name])
  @@map("cities")
}

model LocationCatalogVersion {
  version        String   @id
  artifactSha256 String   @unique @map("artifact_sha256") @db.VarChar(64)
  status         String
  countriesCount Int      @map("countries_count")
  divisionsCount Int      @map("divisions_count")
  citiesCount    Int      @map("cities_count")
  loadedAt       DateTime @map("loaded_at")

  @@map("location_catalog_versions")
}

model User {
  id                      String                 @id @default(uuid())
  email                   String                 @unique
  name                    String
  avatarUrl               String?                @map("avatar_url")
  keepSidebarCollapsed    Boolean                @default(false) @map("keep_sidebar_collapsed")
  chatBubbleColor         String?                @map("chat_bubble_color")
  chatBubbleTextColor     String?                @map("chat_bubble_text_color")
  customerBubbleColor     String?                @map("customer_bubble_color")
  customerBubbleTextColor String?                @map("customer_bubble_text_color")
  chatBackgroundColor     String?                @map("chat_background_color")
  chatBackgroundMode      String                 @default("IMAGE") @map("chat_background_mode")
  passwordHash            String
  status                  UserStatus             @default(ACTIVE)
  platformRole            PlatformRole           @default(USER)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  memberships             TenantMembership[]
  requestedTickets        Ticket[]
  subscriptions           TenantSubscription[]
  platformAuditLogs       PlatformAuditLog[]
  impersonationSessions   ImpersonationSession[]
  passwordResetTokens     PasswordResetToken[]
  authSessions            AuthSession[]

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model Plan {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  description     String?
  status          PlanStatus            @default(DRAFT)
  billingPeriod   PlanBillingPeriod     @default(MANUAL)
  priceCents      Int?
  currency        String                @default("BRL")
  trialDays       Int                   @default(0)
  features        Json
  limits          Json
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  archivedAt      DateTime?
  subscriptions   TenantSubscription[]
  historyPrevious SubscriptionHistory[] @relation("PreviousPlan")
  historyNext     SubscriptionHistory[] @relation("NextPlan")

  @@index([status])
  @@map("plans")
}

model TenantSubscription {
  id                 String                @id @default(uuid())
  tenantId           String?
  planId             String
  clientId           String?
  status             SubscriptionStatus    @default(ACTIVE)
  startsAt           DateTime              @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime              @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean               @default(false)
  indefinite         Boolean               @default(false)
  monthlyValueCents  Int?
  discountCents      Int                   @default(0)
  couponCode         String?
  notes              String?
  cancelledAt        DateTime?
  suspensionReason   String?
  limitsSnapshot     Json
  featuresSnapshot   Json
  createdByUserId    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tenant             Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  plan               Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  client             PlatformClient?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser      User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  history            SubscriptionHistory[]
  invoices           Invoice[]

  @@index([tenantId, status])
  @@index([planId, status])
  @@index([clientId, status])
  @@map("tenant_subscriptions")
}

model SubscriptionHistory {
  id             String              @id @default(uuid())
  subscriptionId String
  tenantId       String?
  previousPlanId String?
  nextPlanId     String?
  previousStatus SubscriptionStatus?
  nextStatus     SubscriptionStatus?
  startsAt       DateTime?
  endsAt         DateTime?
  actorUserId    String?
  reason         String
  createdAt      DateTime            @default(now())
  subscription   TenantSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPlan   Plan?               @relation("PreviousPlan", fields: [previousPlanId], references: [id], onDelete: SetNull)
  nextPlan       Plan?               @relation("NextPlan", fields: [nextPlanId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("subscription_history")
}

model Invoice {
  id                String             @id @default(uuid())
  tenantId          String?
  subscriptionId    String
  number            String             @unique
  status            InvoiceStatus      @default(DRAFT)
  currency          String             @default("BRL")
  subtotalCents     Int                @default(0)
  discountCents     Int                @default(0)
  totalCents        Int                @default(0)
  paidCents         Int                @default(0)
  released          Boolean            @default(false)
  releasedAt        DateTime?
  dueAt             DateTime
  paidAt            DateTime?
  cancelledAt       DateTime?
  externalReference String?
  referenceDate     DateTime?
  reference         String?
  couponCode        String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  subscription      TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([dueAt, status])
  @@map("invoices")
}

model InvoiceCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("invoice_counters")
}

model PlatformSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}

model TenantUsageSnapshot {
  id          String   @id @default(uuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  metric      String
  value       BigInt
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd, metric], map: "tenant_usage_snapshots_tenantId_periodStart_periodEnd_metric_ke")
  @@index([tenantId, periodStart, periodEnd])
  @@map("tenant_usage_snapshots")
}

model ImpersonationSession {
  id                       String              @id @default(uuid())
  actorUserId              String
  tenantId                 String
  impersonatedMembershipId String
  reason                   String
  status                   ImpersonationStatus @default(ACTIVE)
  expiresAt                DateTime
  handoffCodeHash          String?             @unique
  handoffChallenge         String?
  handoffExpiresAt         DateTime?
  handoffConsumedAt        DateTime?
  stoppedAt                DateTime?
  createdAt                DateTime            @default(now())
  actor                    User                @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs                PlatformAuditLog[]
  authSessions             AuthSession[]

  @@index([actorUserId, status, expiresAt])
  @@index([tenantId, status])
  @@index([handoffExpiresAt, handoffConsumedAt])
  @@map("impersonation_sessions")
}

model PlatformAuditLog {
  id                     String                @id @default(uuid())
  actorUserId            String?
  actorPlatformRole      PlatformRole?
  action                 String
  targetType             String
  targetId               String?
  tenantId               String?
  impersonationSessionId String?
  requestId              String?
  ipHash                 String?
  userAgentHash          String?
  metadataJson           Json?
  createdAt              DateTime              @default(now())
  actor                  User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant                 Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  impersonationSession   ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("platform_audit_logs")
}

model TenantMembership {
  id                       String                 @id @default(uuid())
  tenantId                 String
  userId                   String
  roleId                   String
  presentationName         String?                @map("presentation_name")
  status                   MembershipStatus       @default(ACTIVE)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                     Role                   @relation(fields: [tenantId, roleId], references: [tenantId, id])
  departments              DepartmentMembership[]
  conversations            Conversation[]
  messages                 Message[]
  messageReactions         MessageReaction[]
  quickReplies             QuickReply[]
  assignedTickets          Ticket[]               @relation("TicketAssignee")
  createdTickets           Ticket[]               @relation("TicketCreator")
  closedTickets            Ticket[]               @relation("TicketCloser")
  ticketComments           TicketComment[]
  ticketHistory            TicketHistory[]
  ticketAttachments        TicketAttachment[]
  requestedTicketApprovals TicketApproval[]       @relation("TicketApprovalRequester")
  decidedTicketApprovals   TicketApproval[]       @relation("TicketApprovalDecider")
  assignedTicketApprovals  TicketApproval[]       @relation("TicketApprovalAssignee")
  portalContacts           Contact[]              @relation("ContactPortalMembership")
  createdCampaigns         Campaign[]             @relation("CampaignCreator")
  cancelledCampaigns       Campaign[]             @relation("CampaignCanceller")
  sentInvitations          UserInvitation[]       @relation("InvitationSender")
  assignedLeads            Lead[]                 @relation("LeadAssignee")
  notifications            Notification[]
  automationRules          AutomationRule[]       @relation("AutomationCreator")
  authSessions             AuthSession[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@index([roleId])
  @@index([status])
  @@map("tenant_memberships")
}

model AuthSession {
  id                     String                @id @default(uuid())
  userId                 String
  tenantId               String?
  membershipId           String?
  impersonationSessionId String?
  expiresAt              DateTime
  revokedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                 Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership             TenantMembership?     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  impersonationSession   ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([tenantId, membershipId, revokedAt, expiresAt])
  @@index([impersonationSessionId])
  @@index([expiresAt])
  @@index([revokedAt])
