NODE_ENV=development
PORT=3001
NEXOS_HTTP_BODY_LIMIT=100mb
DATABASE_URL=postgresql://nexos:nexos_dev_password@localhost:5432/nexos_0802?schema=public
REDIS_URL=redis://localhost:6379
SEED_MODE=homologation
SEED_ADMIN_EMAIL=admin@nexo.app
SEED_ADMIN_PASSWORD=demo1234
SEED_AGENT_EMAIL=atendente@nexo.app
SEED_AGENT_PASSWORD=demo1234
NEXOS_QUEUE_ENABLED=true
NEXOS_QUEUE_WORKER_ENABLED=true
JWT_SECRET=nexos-homologation-access-2026-08-11-local-secret
JWT_REFRESH_SECRET=nexos-homologation-refresh-2026-08-11-local-secret
FRONTEND_ORIGIN=http://localhost:5173
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-dev-key
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3001/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=nexos-homologation-evolution-webhook-2026-08-11

NEXOS_REALTIME_ENABLED=true
NEXOS_REALTIME_REDIS_ADAPTER_ENABLED=true
NEXOS_REALTIME_PATH=/socket.io
NEXOS_REALTIME_CORS_ORIGIN=http://localhost:5173
NEXOS_PRESENCE_TTL_SECONDS=90

NEXOS_MESSAGE_MAX_IMAGE_SIZE_MB=8
NEXOS_MESSAGE_MAX_AUDIO_SIZE_MB=16
NEXOS_MESSAGE_MAX_DOCUMENT_SIZE_MB=25
NEXOS_MESSAGE_MAX_VIDEO_SIZE_MB=32
NEXOS_MESSAGE_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
NEXOS_MESSAGE_ALLOWED_AUDIO_MIME_TYPES=audio/ogg,audio/mpeg,audio/mp4,audio/webm
NEXOS_MESSAGE_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
NEXOS_MESSAGE_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/3gpp,video/webm
NEXOS_MESSAGE_ALLOW_GROUP_CONVERSATIONS=true
