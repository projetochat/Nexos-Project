NODE_ENV=development
PORT=3001
TRIXUS_HTTP_BODY_LIMIT=100mb
DATABASE_URL=postgresql://trixus:trixus_dev_password@localhost:5432/trixus_0802?schema=public
REDIS_URL=redis://localhost:6379
SEED_MODE=homologation
SEED_ADMIN_EMAIL=admin@trixus.app
SEED_ADMIN_PASSWORD=demo1234
SEED_AGENT_EMAIL=atendente@trixus.app
SEED_AGENT_PASSWORD=demo1234
TRIXUS_PLATFORM_ADMIN_EMAIL=platform@trixus.app
TRIXUS_PLATFORM_ADMIN_PASSWORD=demo1234
TRIXUS_PLATFORM_SUPPORT_EMAIL=platform-support@trixus.app
TRIXUS_PLATFORM_SUPPORT_PASSWORD=demo1234
TRIXUS_PLATFORM_READONLY_EMAIL=platform-readonly@trixus.app
TRIXUS_PLATFORM_READONLY_PASSWORD=demo1234
TRIXUS_QUEUE_ENABLED=true
TRIXUS_QUEUE_WORKER_ENABLED=true
JWT_SECRET=trixus-homologation-access-2026-08-11-local-secret
JWT_REFRESH_SECRET=trixus-homologation-refresh-2026-08-11-local-secret
FRONTEND_ORIGIN=http://localhost:5173
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-dev-key
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3001/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=trixus-homologation-evolution-webhook-2026-08-11

TRIXUS_REALTIME_ENABLED=true
TRIXUS_REALTIME_REDIS_ADAPTER_ENABLED=true
TRIXUS_REALTIME_PATH=/socket.io
TRIXUS_REALTIME_CORS_ORIGIN=http://localhost:5173
TRIXUS_PRESENCE_TTL_SECONDS=90

TRIXUS_MESSAGE_MAX_IMAGE_SIZE_MB=8
TRIXUS_MESSAGE_MAX_AUDIO_SIZE_MB=16
TRIXUS_MESSAGE_MAX_DOCUMENT_SIZE_MB=25
TRIXUS_MESSAGE_MAX_VIDEO_SIZE_MB=32
TRIXUS_MESSAGE_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
TRIXUS_MESSAGE_ALLOWED_AUDIO_MIME_TYPES=audio/ogg,audio/mpeg,audio/mp4,audio/webm
TRIXUS_MESSAGE_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
TRIXUS_MESSAGE_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/3gpp,video/webm
TRIXUS_MESSAGE_ALLOW_GROUP_CONVERSATIONS=true
