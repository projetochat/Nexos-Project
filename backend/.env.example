NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://nexos:nexos_dev_password@localhost:5432/nexos_0802?schema=public
REDIS_URL=redis://localhost:6379
SEED_MODE=homologation
SEED_ADMIN_EMAIL=admin@nexo.app
SEED_ADMIN_PASSWORD=demo1234
SEED_AGENT_EMAIL=atendente@nexo.app
SEED_AGENT_PASSWORD=demo1234
NEXOS_QUEUE_ENABLED=true
NEXOS_QUEUE_WORKER_ENABLED=true
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
FRONTEND_ORIGIN=http://localhost:5173
