# Copy to .env.vps on the VPS. Do not commit that file or copy local credentials into it.
COMPOSE_PROJECT_NAME=trixus-vps
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<strong-database-password>
# Use the internal Compose host `postgres`; percent-encode URI-reserved
# characters in the password (for example @, :, /, ?, # and %).
DATABASE_URL=postgresql://<database-user>:<url-encoded-database-password>@postgres:5432/<database-name>?schema=public
BACKEND_PORT=3001
VITE_TRIXUS_API_URL=https://api.example.com/api
VITE_TRIXUS_PLATFORM_APP_URL=https://app.trixus.com.br
VITE_TRIXUS_TENANT_APP_URL=https://chat.trixus.com.br
VITE_APP_MODE=production
# Required only while the legacy Supabase-based frontend surface remains in use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-side compatibility for the legacy Supabase integration. Keep the
# service-role key private; it is never exposed to browser bundles.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=production
TRIXUS_ENVIRONMENT=production
PORT=3001
BACKEND_HOST=0.0.0.0
TRIXUS_HTTP_BODY_LIMIT=100mb
TRIXUS_HEALTH_CHECK_TIMEOUT_MS=2000
JWT_SECRET=<generate-a-unique-long-secret>
JWT_REFRESH_SECRET=<generate-a-different-unique-long-secret>
FRONTEND_ORIGIN=https://app.trixus.com.br,https://chat.trixus.com.br
TRIXUS_REALTIME_CORS_ORIGIN=https://chat.trixus.com.br
TRIXUS_PLATFORM_APP_URL=https://app.trixus.com.br
TRIXUS_TENANT_APP_URL=https://chat.trixus.com.br
# Optional legacy fallback. New deployments should use the two explicit URLs above.
TRIXUS_PUBLIC_APP_URL=
REDIS_URL=redis://redis:6379
RESEND_API_KEY=<resend-api-key>
TRIXUS_EMAIL_FROM=Trixus <acesso@example.com>
TENANT_ADMIN_PROVISIONING_MODE=invitation_email

TRIXUS_QUEUE_ENABLED=true
TRIXUS_QUEUE_WORKER_ENABLED=true
TRIXUS_HISTORY_IMPORT_WORKER_ENABLED=false
TRIXUS_DEFERRED_REPLAY_WORKER_ENABLED=false
TRIXUS_OUTBOUND_WORKER_CONCURRENCY=5
TRIXUS_OUTBOX_POLL_INTERVAL_MS=1000
TRIXUS_REALTIME_ENABLED=true
TRIXUS_REALTIME_REDIS_ADAPTER_ENABLED=true
TRIXUS_REALTIME_PATH=/socket.io
TRIXUS_REALTIME_SUBSCRIPTION_LIMIT=25
TRIXUS_PRESENCE_TTL_SECONDS=90

# Absolute host path, owned by the service account and included in backups.
TRIXUS_STORAGE_PROVIDER=local
TRIXUS_STORAGE_HOST_PATH=/srv/trixus-data
TRIXUS_STORAGE_MAX_FILE_SIZE_MB=10
TRIXUS_MESSAGE_STORAGE_PROVIDER=local
TRIXUS_ATTACHMENT_PENDING_MAX_MINUTES=60

# Configure all four only when Evolution inbound/outbound is intentionally enabled.
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=<strong-evolution-api-key>
EVOLUTION_SERVER_URL=https://<evolution-public-domain>
EVOLUTION_WEBHOOK_PUBLIC_URL=https://<api-public-domain>/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=<strong-evolution-webhook-secret>
EVOLUTION_TIMEOUT_MS=10000
# Timeout total por download remoto de mídia (DNS, redirecionamentos e streaming).
TRIXUS_MEDIA_DOWNLOAD_TIMEOUT_MS=15000
# Origens HTTP(S) privadas adicionais, exatas e separadas por vírgula. A origem de
# EVOLUTION_BASE_URL já é autorizada automaticamente; mantenha vazio se não precisar.
TRIXUS_MEDIA_DOWNLOAD_ALLOWED_ORIGINS=
EVOLUTION_POSTGRES_DATABASE=evolution_db
EVOLUTION_POSTGRES_USERNAME=evolution
EVOLUTION_POSTGRES_PASSWORD=<strong-evolution-database-password>

# Used only by the explicit, reviewed seed action. Existing administrators are preserved.
TRIXUS_PLATFORM_ADMIN_EMAIL=<platform-admin-email>
TRIXUS_PLATFORM_ADMIN_PASSWORD=<strong-bootstrap-password>
ALLOW_DEMO_USER_PROVISIONING=false
