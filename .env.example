# Frontend MVP (Supabase legacy/current MVP)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_TRIXUS_API_URL=http://localhost:3001/api
VITE_TRIXUS_PLATFORM_APP_URL=https://app.trixus.com.br
VITE_TRIXUS_TENANT_APP_URL=https://chat.trixus.com.br
VITE_APP_MODE=homologation
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend
NODE_ENV=development
TRIXUS_ENVIRONMENT=staging
PORT=3001
BACKEND_HOST=0.0.0.0
TRIXUS_HTTP_BODY_LIMIT=100mb

# Apenas para Compose local. Estes assumem valores de desenvolvimento quando omitidos do docker-compose.yml.
POSTGRES_DB=trixus_local
POSTGRES_USER=trixus
POSTGRES_PASSWORD=change-me-local-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trixus:change-me-local-database-password@localhost:5432/trixus_local?schema=public
REDIS_URL=redis://localhost:6379

# O seed oficial apenas inicializa este Administrador da Plataforma e nunca o sobrescreve.
TRIXUS_PLATFORM_ADMIN_EMAIL=platform@trixus.app
TRIXUS_PLATFORM_ADMIN_PASSWORD=change-me-platform-admin-password
TRIXUS_QUEUE_ENABLED=true
TRIXUS_QUEUE_WORKER_ENABLED=true
TRIXUS_OUTBOUND_WORKER_CONCURRENCY=5
TRIXUS_OUTBOX_POLL_INTERVAL_MS=1000

# Nunca reutilize valores locais em ambientes de staging ou produção.
JWT_SECRET=change-me-local-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-local-refresh-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
TRIXUS_PLATFORM_APP_URL=http://localhost:5173
TRIXUS_TENANT_APP_URL=http://localhost:5173

# Mecanismo de fallback legado enquanto ambientes mais antigos são migrados para as duas URLs acima.
TRIXUS_PUBLIC_APP_URL=http://localhost:5173

# Convites de acesso enviados pela API do Resend. Obrigatórios em produção.
RESEND_API_KEY=
TRIXUS_EMAIL_FROM=Trixus <acesso@seudominio.com.br>
TENANT_ADMIN_PROVISIONING_MODE=temporary_password
ALLOW_DEMO_USER_PROVISIONING=false

# Provedor da Evolution API
# URL padrão da API no Docker local. Não exponha esta chave em pacotes de frontend.
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-dev-key
EVOLUTION_TIMEOUT_MS=10000
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3001/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=change-me-evolution-webhook-secret
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_POSTGRES_DATABASE=evolution_db
EVOLUTION_POSTGRES_USERNAME=evolution
EVOLUTION_POSTGRES_PASSWORD=change-me-evolution-database-password

TRIXUS_REALTIME_ENABLED=true
TRIXUS_REALTIME_REDIS_ADAPTER_ENABLED=true
TRIXUS_REALTIME_PATH=/socket.io
TRIXUS_REALTIME_CORS_ORIGIN=http://localhost:5173
TRIXUS_PRESENCE_TTL_SECONDS=90
TRIXUS_REALTIME_SUBSCRIPTION_LIMIT=25

# Armazenamento local em host único. Use um caminho absoluto fora do checkout antes de realizar o deploy em uma VPS.
TRIXUS_STORAGE_PROVIDER=local
TRIXUS_STORAGE_LOCAL_PATH=../trixus-storage/tickets
TRIXUS_STORAGE_MAX_FILE_SIZE_MB=10
TRIXUS_MESSAGE_STORAGE_PROVIDER=local
TRIXUS_MESSAGE_STORAGE_LOCAL_PATH=../trixus-storage/messages
TRIXUS_ATTACHMENT_PENDING_MAX_MINUTES=60

# Política de mídia do Messaging Core 15.2
TRIXUS_MESSAGE_MAX_IMAGE_SIZE_MB=8
TRIXUS_MESSAGE_MAX_AUDIO_SIZE_MB=16
TRIXUS_MESSAGE_MAX_DOCUMENT_SIZE_MB=25
TRIXUS_MESSAGE_MAX_VIDEO_SIZE_MB=32
TRIXUS_MESSAGE_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
TRIXUS_MESSAGE_ALLOWED_AUDIO_MIME_TYPES=audio/ogg,audio/mpeg,audio/mp4,audio/webm
TRIXUS_MESSAGE_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/vcard
TRIXUS_MESSAGE_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/3gpp,video/webm
TRIXUS_MESSAGE_ALLOW_GROUP_CONVERSATIONS=true

# Necessário apenas para a rotina separada de sincronização de limites de plano, não para o seed.
STAGING_PLAN_CODE=professional
STAGING_MAX_CONNECTIONS=5
