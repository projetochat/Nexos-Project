# Backend Sprint 01
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://nexos:nexos_dev_password@localhost:5432/nexos?schema=public
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
